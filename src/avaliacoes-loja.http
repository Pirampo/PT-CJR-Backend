@baseUrl = http://localhost:3001

# Cole aqui o access_token que o login (passo 1) devolver
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjEsImVtYWlsIjoidGVzdGVAZW1haWwuY29tIiwiaWF0IjoxNzkzOTEzMzk3LCJleHAiOjE3OTM5OTk3OTd9.cK6iJJkpWKtmp26r72CvnuqyCRzEPCL0rU1gYGWfur4

# Token de um SEGUNDO usuário, para o teste do passo 10
@token2 = TOKEN_DO_OUTRO_USUARIO

###

GET http://localhost:3001/user/me
Authorization: Bearer {{token}}

###
POST http://localhost:3001/lojas
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "usuario_id":1,
  "nome": "Loja de Teste",
  "descricao": "Loja criada para testar avaliações"
}
### 1. Login

POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "teste@email.com",
  "senha": "123456"
}

### 2. Conferir lojas (para saber um loja_id que existe)

GET {{baseUrl}}/lojas
Authorization: Bearer {{token}}

### 3. Criar avaliação

POST {{baseUrl}}/avaliacoes-loja
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "loja_id": 1,
  "nota": 5,
  "comentario": "Loja ótima, entrega rápida!"
}

### 4. Listar avaliações

GET {{baseUrl}}/avaliacoes-loja

### 5. Buscar avaliação por ID (sem token)

GET {{baseUrl}}/avaliacoes-loja/1

### 6. Atualizar avaliação

PATCH {{baseUrl}}/avaliacoes-loja/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nota": 4,
  "comentario": "Mudei de ideia, demorou um pouco."
}

### 7. ERRO esperado 400: nota fora de 1 a 5

POST {{baseUrl}}/avaliacoes-loja
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "loja_id": 1,
  "nota": 6
}

### 8. ERRO esperado 404: loja que não existe

POST {{baseUrl}}/avaliacoes-loja
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "loja_id": 99999,
  "nota": 3
}

### 9. ERRO esperado 401: criar sem token

POST {{baseUrl}}/avaliacoes-loja
Content-Type: application/json

{
  "loja_id": 1,
  "nota": 3
}

### 10. ERRO esperado 403: outro usuário tentando alterar a avaliação

PATCH {{baseUrl}}/avaliacoes-loja/1
Content-Type: application/json
Authorization: Bearer {{token2}}

{
  "nota": 1
}

### 11. Excluir avaliação

DELETE {{baseUrl}}/avaliacoes-loja/1
Authorization: Bearer {{token}}

### 12. Conferir exclusão: esperado 404

GET {{baseUrl}}/avaliacoes-loja/1
